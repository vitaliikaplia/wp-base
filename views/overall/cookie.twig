{# Cookie consent popup content comes from the custom options framework. #}
{% set cookie_title = get_option('cookie_popup_title') %}
{% set cookie_text = get_option('cookie_popup_text') %}
{% set cookie_button = get_option('cookie_popup_button_title') %}

{% if cookie_title and cookie_text and cookie_button %}
<div class="cookiePopupWrapper">
    <div class="cookiePopup">
        {% if cookie_title %}
        <p class="title">
            <svg>
                <use href="{{ svg_sprite }}#cookie-icon"></use>
            </svg>
            <span>{{ cookie_title }}</span>
        </p>
        {% endif %}
        <div class="cls">
            {% if cookie_text %}
            <div class="message">
                <input type="checkbox" id="cookie_text_toggle" hidden>
                <div class="toggledContent">
                    <label class="button" for="cookie_text_toggle">{{ __('Tell me more about cookies', TEXTDOMAIN) }}</label>
                    <div class="typo">{{ cookie_text }}</div>
                </div>
            </div>
            {% endif %}
            {% if cookie_button %}
            <button class="accept btn primary" type="button">{{ cookie_button }}</button>
            {% endif %}
        </div>
    </div>
</div>
{% endif %}
