{# Test footer — minimal chrome wired to the Footer ACF options. Style per project. #}
<footer class="site-footer">
    <div class="inner">
        <div class="site-footer-socials">
            {% if general_fields.footer_socials %}
            <ul class="site-socials">
                {% for s in general_fields.footer_socials %}
                    {% if s.url %}
                    <li><a href="{{ s.url }}" target="_blank" rel="noopener">{{ icon(s.icon) }}</a></li>
                    {% endif %}
                {% endfor %}
            </ul>
            {% endif %}
        </div>

        <nav class="site-footer-nav">
            {% if general_fields.footer.menu.html %}{{ general_fields.footer.menu.html }}{% endif %}
        </nav>

        <div class="site-footer-copy-wrap">
            {% if general_fields.footer.copy_line %}
            <p class="site-footer-copy">{{ general_fields.footer.copy_line | shortcodes }}</p>
            {% endif %}
        </div>
    </div>
</footer>
