<label for="{{ name }}">
    {% if val.options is iterable %}
    <select class="custom-options-{{ val.type }}" name="{{ name }}" id="{{ name }}">
        {% for o_key,o_val in val.options %}
        <option value="{{ o_key|esc_attr }}"{% if o_key == value %} selected="selected"{% endif %}>{{ o_val|esc_html }}</option>
        {% endfor %}
    </select>
    {% endif %}
    {% if description %}
    <p class="description">{{ description }}</p>
    {% endif %}
</label>
